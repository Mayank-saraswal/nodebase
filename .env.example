DO_SPACES_SECRET=""
DO_SPACES_ENDPOINT="https://blr1.digitaloceanspaces.com"
DO_SPACES_BUCKET="nodebase-media"
DO_SPACES_REGION="blr1"
DO_SPACES_CDN_URL=""
DO_SPACES_SAS_EXPIRY_HOURS="48"
