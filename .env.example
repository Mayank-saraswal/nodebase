BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
#github client id 
GITHUB_CLIENT_ID = 
GITHUB_CLIENT_SECRET = 

GOOGLE_CLIENT_ID = 
GOOGLE_CLIENT_SECRET=



Local PostgreSQL database (Docker)
DATABASE_URL='postgresql://workflow_user:workflow_password@localhost:5432/workflow_db'

# Direct database URL for Prisma migrations (bypasses connection pooler).
# In local dev, this can be the same as DATABASE_URL.
# In production with a pooler (Supabase/Neon/PgBouncer), set this to
# the direct (non-pooled) connection string so migrations work correctly.
DIRECT_DATABASE_URL='postgresql://workflow_user:workflow_password@localhost:5432/workflow_db'

#goolge api key
GOOGLE_GENERATIVE_AI_API_KEY=
#chatgpt
OPENAI_API_KEY=""


ANTHROPIC_API_KEY = ""
#groq
GROQ_API_KEY=
#xai
XAI_API_KEY=

SENTRY_AUTH_TOKEN=


#polar
POLAR_ACCESS_TOKEN=

POLAR_SUCCESS_URL="http://localhost:3000"


#other 
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
#encripting user cred 

ENCRYPTION_KEY = "my-secure-key"

# ── Corsair integration backbone (self-hosted SDK) ─────────────────────────
# Master switch. Keep false until Phase 1 migration is applied and KEK is set.
CORSAIR_ENABLED=false
# Root encryption key for Corsair envelope encryption (NOT the same as ENCRYPTION_KEY).
# Generate: openssl rand -base64 32
CORSAIR_KEK=
# Per-plugin cutover flags (require CORSAIR_ENABLED=true). Gmail defaults on when master is true.
CORSAIR_PLUGIN_GMAIL=true
CORSAIR_PLUGIN_GOOGLESHEETS=false
CORSAIR_PLUGIN_GOOGLEDRIVE=false
CORSAIR_PLUGIN_SLACK=false
CORSAIR_PLUGIN_GITHUB=false
CORSAIR_PLUGIN_HUBSPOT=false
CORSAIR_PLUGIN_NOTION=false
CORSAIR_PLUGIN_TELEGRAM=false
CORSAIR_PLUGIN_DISCORD=false
CORSAIR_PLUGIN_TWITTER=false
CORSAIR_PLUGIN_RAZORPAY=false
CORSAIR_PLUGIN_STRIPE=false
CORSAIR_PLUGIN_OPENAI=false
CORSAIR_PLUGIN_DEEPSEEK=false
CORSAIR_PLUGIN_GEMINI=false
CORSAIR_PLUGIN_PERPLEXITY=false
# Optional pg pool size for Corsair
CORSAIR_PG_POOL_MAX=10

NODE_ENV = "devlopment"

SENTRY_AUTH_TOKEN=

DEEPSEEK_API_KEY=""

PERPLEXITY_API_KEY=""

GOOGLE_SHEETS_CLIENT_ID=""
GOOGLE_SHEETS_CLIENT_SECRET=""

GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# DigitalOcean Spaces (S3-compatible Object Storage)
